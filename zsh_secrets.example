# Sensitive information (API keys, tokens, etc.)
# This file is ignored by git.


# ~/.zsh_secrets の中身（ここには本物のキーを書く）
export AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxx"
export OPENAI_API_KEY="sk-xxxxxxxxxxxxxx"
# Google Vertex AI Project Configuration
export GOOGLE_VERTEX_PROJECT="your-project-id"

# Note: GITHUB_TOKEN is managed via GitHub CLI (gh auth login).
